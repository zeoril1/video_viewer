# ===== Публичный доступ к Video Viewer из интернета (профиль public) =====
#
# Caddy — обратный прокси с автоматическим HTTPS (Let's Encrypt): принимает
# запросы на 80/443, сам получает и продлевает сертификат для домена из
# PUBLIC_DOMAIN и проксирует всё на gateway:8080 во внутренней сети compose.
# Дальше шлюз отдаёт статику и проксирует /api/* по микросервисам.
#
# Запуск (добавить caddy к уже работающему стеку):
#   docker compose --profile public up -d
#
# PUBLIC_DOMAIN — домен, A-запись которого указывает на ваш публичный IP
# (при динамическом IP подойдёт, например, DuckDNS: vv-home.duckdns.org).
# Если переменная пуста, Caddy поднимется на localhost с самоподписанным
# сертификатом — удобно проверить саму конфигурацию локально.
#
# Host запроса Caddy сохраняет, поэтому CSRF-проверка (Origin == Host) и
# абсолютные ссылки в ответах (например, экспорт IPTV в m3u) указывают на
# публичный адрес, а флаг Secure у куки сессии включается автоматически
# (Caddy передаёт X-Forwarded-Proto: https).

{$PUBLIC_DOMAIN:localhost} {
	# Стриминг (Range-запросы видео), HLS-сегменты и IPTV-live отдаются
	# потоком — без накопления ответа в буфере прокси.
	reverse_proxy gateway:8080 {
		flush_interval -1
	}

	# Сжатие НЕ включаем: видео и HLS-сегменты уже сжаты, а буферизация
	# сломала бы потоковую отдачу.

	# Журнал доступа Caddy → stdout контейнера (docker compose logs caddy).
	log {
		output stdout
		format console
	}
}
