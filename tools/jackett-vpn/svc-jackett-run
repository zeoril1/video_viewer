#!/usr/bin/with-contenv bash
# Updating from upstream would remove the routing patch. Updates are image builds.
if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    exec s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z localhost 9117" \
        s6-setuidgid abc /app/Jackett/jackett --NoUpdates ${RUN_OPTS}
else
    exec s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z localhost 9117" \
        /app/Jackett/jackett --NoUpdates ${RUN_OPTS}
fi
