# ===== video_viewer: переменные окружения =====
# Скопируйте в .env и при необходимости отредактируйте.
# docker-compose автоматически подхватывает .env из каталога проекта.

# --- PostgreSQL ---
POSTGRES_DB=video_viewer
POSTGRES_USER=video_viewer
POSTGRES_PASSWORD=video_viewer

# --- TMDB (api.themoviedb.org) ---
# Два ключа (https://www.themoviedb.org/settings/api):
# TMDB_API_KEY — «API Key» (v3, запасной вариант авторизации);
# TMDB_ACCESS_TOKEN — «API Read Access Token» (рекомендуемый, Bearer).
# Хотя бы один из них включает чарты (top_rated/popular) и внешний поиск.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# --- Прокси для IMDb ---
# Только статические прокси (динамические списки PROXY_SOURCES убраны).
# Формат host:port или http://user:pass@host:port для прокси с авторизацией.
PROXY_STATIC=
# PROXY_TIMEOUT — таймаут подключения через прокси.
PROXY_TIMEOUT=10s
# PROXY_MAX_ATTEMPTS — попыток failover между прокси на запрос.
PROXY_MAX_ATTEMPTS=3

# --- Jackett (поиск раздач на трекерах с антиботом, напр. RuTracker) ---
# Jackett поднимается вместе с сайтом (сервис jackett в docker-compose,
# веб-интерфейс http://localhost:9117). JACKETT_URL по умолчанию уже
# указывает на него (http://jackett:9117 — внутренняя сеть compose).
# Нужно сделать вручную:
#   1) добавить индексер RuTracker.org в веб-интерфейсе Jackett
#      (логин/пароль + капча — это вводится в самом Jackett);
#   2) указать API-ключ Jackett — он лежит в ./jackett/Jackett/ServerConfig.json
#      (поле "APIKey") или виден на вкладке Dashboard веб-интерфейса.
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=
# JACKETT_INDEXER — ID индексера (имя файла в ./jackett/Jackett/Indexers/*.json
# без расширения, напр. rutracker-ru, noname-club), список через запятую для
# поиска по нескольким, или "all" — по всем настроенным. Несуществующий ID
# даст "Indexer is not configured" (поиск по остальным продолжится).
JACKETT_INDEXER=rutracker-ru

# --- Авторизация ---
# DEV_USER / DEV_PASSWORD — разработческий пользователь, создаётся при
# старте, только если заданы ОБА значения (иначе не создаётся).
# ВАЖНО: не задавайте на публичном деплое (интернет) — это готовый вход
# в ваш сервер. Порядок настройки публичного доступа — в README,
# раздел «Доступ извне».
DEV_USER=
DEV_PASSWORD=
# COOKIE_SECURE — обычно НЕ нужен: флаг Secure на куке сессии ставится
# автоматически, когда запрос пришёл по HTTPS (напрямую или через
# обратный прокси — Caddy/nginx передаёт X-Forwarded-Proto). Так один и
# тот же сервис работает и по локальному http://192.168.x.x:8080, и по
# публичному https://домен. Задайте COOKIE_SECURE=1 только если прокси
# не передаёт X-Forwarded-Proto и вы точно работаете по HTTPS.
COOKIE_SECURE=

# --- IPTV ---
# Плейлисты (M3U-ссылка или Xtream Codes) добавляются прямо в интерфейсе:
# кнопка «IPTV» → «Плейлисты» (нужна роль admin). Пароли провайдера
# хранятся в БД и клиенту не отдаются: поток идёт через наш сервис.
#
# Публичный список русских каналов (для проверки):
#   https://iptv-org.github.io/iptv/languages/rus.m3u
# Телепрограмма (XMLTV), необязательно — указывается в самом плейлисте
# (поле «URL телепрограммы XMLTV»). Для каналов РФ проверен вариант:
#   https://www.teleguide.info/download/new3/xmltv.xml.gz
# (сопоставление по названию: id в файле числовые). Бесплатные файлы
# open-epg.com для РФ — демо из 10 каналов, они не подходят.
#
# IPTV_DATA_DIR — каталог временных HLS-сессий ffmpeg (том iptv-cache).
IPTV_DATA_DIR=/app/cache
# IPTV_MAX_SESSIONS — сколько каналов можно смотреть одновременно
# (каждый MPEG-TS-канал занимает процесс ffmpeg; HLS-каналы проксируются
# без него и в лимит по CPU не упираются).
IPTV_MAX_SESSIONS=8
# IPTV_SESSION_IDLE — через сколько без запросов гасить ffmpeg-сессию канала.
IPTV_SESSION_IDLE=90s
# IPTV_SYNC_INTERVAL / IPTV_EPG_INTERVAL — периодичность фонового обновления
# каналов и телепрограммы (0 — обновлять только вручную кнопкой в админке).
IPTV_SYNC_INTERVAL=6h
IPTV_EPG_INTERVAL=3h

# --- Доступ из интернета (необязательный профиль public) ---
# Обычный `docker compose up -d` профиль public не запускает: локальная
# сеть работает по http://<IP-хоста>:8080 без всякой настройки. Для
# доступа из интернета поднимите caddy (HTTPS + сертификат):
#   docker compose --profile public up -d
# и на роутере пробросьте 80→80 и 443→443 на этот хост.
#
# PUBLIC_DOMAIN — домен, A-запись которого указывает на ваш публичный IP
# (при динамическом IP — сервис вроде DuckDNS, напр. vv-home.duckdns.org).
# Caddy сам получит и продлит сертификат Let's Encrypt.
# Оставьте пустым, если публичный доступ не нужен.
PUBLIC_DOMAIN=
